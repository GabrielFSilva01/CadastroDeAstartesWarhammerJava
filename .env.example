# ============================================================
# .env.example — Modelo de variáveis de ambiente
# ============================================================
# INSTRUÇÕES:
#   1. Copie este arquivo: copy .env.example .env
#   2. Preencha os valores reais em .env
#   3. NUNCA commite o arquivo .env (já está no .gitignore)
#
# O arquivo .env é lido automaticamente pelo Docker Compose.
# O Spring Boot lê as variáveis via ${VAR_NAME} no application.yml.
# ============================================================

# ── PostgreSQL (Docker Container) ─────────────────────────
POSTGRES_DB=cogitator_imperialis
POSTGRES_USER=cogitator
POSTGRES_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE_AQUI

# ── Spring Boot (deve espelhar os valores acima) ──────────
DB_HOST=localhost
DB_PORT=5433
DB_NAME=${POSTGRES_DB}
DB_USERNAME=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}

# ── Perfil ativo do Spring Boot ───────────────────────────
# Valores: dev | prod
SPRING_PROFILES_ACTIVE=dev
